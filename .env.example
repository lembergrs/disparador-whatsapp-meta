# Ambiente da aplicação: local, dev, development ou production
APP_ENV=local

APP_TIMEZONE=America/Sao_Paulo

# Analytics (deixe GOOGLE_TAG_MANAGER_ID vazio para desabilitar; GA4 é gerenciado no GTM)
GOOGLE_TAG_MANAGER_ID=GTM-5BV2SLDR
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-H6JP7C3CHG

# Task Scheduler (infraestrutura paralela; não ativa módulos automaticamente)
TASK_SCHEDULER_BATCH_SIZE=50
TASK_SCHEDULER_LEASE_MINUTES=15

# Banco de dados
DB_HOST=localhost
DB_NAME=whatsapp_disparador
DB_USER=root
DB_PASS=
DB_PORT=3306

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=coloque_sua_site_key_aqui
RECAPTCHA_SECRET_KEY=coloque_sua_secret_key_aqui

########################################
# META / WHATSAPP
########################################
META_APP_ID=
META_APP_SECRET=
META_CONFIGURATION_ID=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_REDIRECT_URI=
META_GRAPH_VERSION=v23.0
META_COEXISTENCE_ENABLED=false
META_COEXISTENCE_TEST_CLIENT_IDS=
WHATSAPP_INSTITUCIONAL_PHONE_NUMBER_ID=
WHATSAPP_INSTITUCIONAL_WABA_ID=
WHATSAPP_INSTITUCIONAL_ACCESS_TOKEN=
WHATSAPP_INSTITUCIONAL_API_VERSION=v23.0
WHATSAPP_INSTITUCIONAL_IDIOMA=pt_BR
WHATSAPP_INSTITUCIONAL_TIMEOUT=15
WHATSAPP_TEMPLATE_FINANCEIRO_COBRANCA_DISPONIVEL=
WHATSAPP_TEMPLATE_FINANCEIRO_LEMBRETE_VENCIMENTO_D3=
WHATSAPP_TEMPLATE_FINANCEIRO_COBRANCA_VENCIDA_D1=
WHATSAPP_TEMPLATE_FINANCEIRO_LEMBRETE_VENCIDA_D3=
WHATSAPP_TEMPLATE_FINANCEIRO_AVISO_SUSPENSAO_D5=
WHATSAPP_TEMPLATE_FINANCEIRO_SUSPENSAO_INADIMPLENCIA_D7=
WHATSAPP_TEMPLATE_FINANCEIRO_PAGAMENTO_CONFIRMADO=

# Homologação temporária: vazio mantém o funcionamento normal para todas as cobranças elegíveis.
FINANCEIRO_NOTIFICACOES_COBRANCAS_PERMITIDAS=
########################################
# ASAAS
########################################
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_BASE_URL_SANDBOX=https://sandbox.asaas.com/api/v3
ASAAS_API_BASE_URL_PRODUCTION=https://api.asaas.com/v3

# Caminho público relativo usado ao salvar uploads no banco
UPLOADS_PUBLIC_PATH=/uploads

########################################
# NFS-e RL2 (sem valores reais no repositório)
########################################
NFSE_API_BASE_URL=https://api.disparador.net
NFSE_API_AUTH_TOKEN=
NFSE_PRESTADOR_CNPJ=
NFSE_PRESTADOR_IM=
NFSE_PRESTADOR_OP_SIMPLES=
NFSE_LOCAL_EMISSAO_IBGE=
NFSE_DPS_SERIE=900
NFSE_CODIGO_TRIBUTACAO_NACIONAL=
NFSE_DESCRICAO_SERVICO=Licenciamento de uso da plataforma
NFSE_AMBIENTE=sandbox
NFSE_CERT_PATH=/caminho/privado/fora-do-document-root/certificado.pfx
NFSE_CERT_PASSWORD=
NFSE_CONNECT_TIMEOUT=10
NFSE_REQUEST_TIMEOUT=30

########################################
# E-MAIL TRANSACIONAL / SMTP
########################################
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Disparador.net
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=Suporte Disparador.net
MAIL_TIMEOUT=10
