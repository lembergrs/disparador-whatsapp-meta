RewriteEngine On

# Expõe arquivos públicos gravados em public/uploads mantendo URLs /uploads/...
# O DocumentRoot de produção aponta para a raiz do projeto.
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# Sitemap dinâmico: inclui apenas artigos publicados.
RewriteRule ^sitemap\.xml$ index.php?url=sitemap [QSA,L]

# Não redireciona arquivos e pastas reais
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redireciona o restante para index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
